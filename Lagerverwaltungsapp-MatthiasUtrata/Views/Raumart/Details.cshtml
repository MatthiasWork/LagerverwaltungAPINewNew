@model Lagerverwaltungsapp_MatthiasUtrata.Models.Raumart

@{
    ViewData["Title"] = "Raumart";
}

<h1>Raumart</h1>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Räume</dt>
        <dd class="col-sm-10">
            @if (Model.Raum.Any())
            {
                @foreach (var raum in Model.Raum.OrderBy(r => r.ID))
                {
                    <a asp-controller="Raum" asp-action="Details" asp-route-id="@raum.ID" class="me-2">@raum.ID</a>
                }
            }
            else
            {
                <span class="text-muted">keine</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary">Bearbeiten</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Zurück zur Übersicht</a>
</div>
