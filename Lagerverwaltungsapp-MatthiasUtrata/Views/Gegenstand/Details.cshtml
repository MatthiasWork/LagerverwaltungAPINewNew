@model Lagerverwaltungsapp_MatthiasUtrata.Models.GegenstandDetailsViewModel
@using Lagerverwaltungsapp_MatthiasUtrata.Extensions

@{
    var gegenstand = Model.Eintrag.Gegenstand;
    ViewData["Title"] = gegenstand.Name;

    var istAdmin = User.IsInRole("Admin");
    var personID = User.GetPersonID() ?? 0;
    var eigeneRaumIDs = Model.EigeneRaumIDs;
    var hatRaum = eigeneRaumIDs.Count > 0;
    // Eine Ausleihe geht von einem eigenen Raum aus, daher nur, wenn der Gegenstand dort liegt.
    // Standorte ist nach Menge sortiert, der erste Treffer ist also der eigene Raum mit dem meisten Bestand.
    var ausEigenemRaum = Model.Eintrag.Standorte.FirstOrDefault(r => eigeneRaumIDs.Contains(r.RaumID));
    var kannAusleihen = ausEigenemRaum != null;
    // Ein Admin verleiht auch aus einem Lager (Raum.DarfBuchen), und zwar aus dem mit dem meisten Bestand.
    var verleihenAusLager = kannAusleihen || !istAdmin
        ? null
        : Model.Eintrag.Standorte.FirstOrDefault(r => !eigeneRaumIDs.Contains(r.RaumID) && r.Raum.Raumart.IstLager);
    // Einbuchen geht in einen eigenen Raum, ein Gerät mit Seriennummer nur, solange es weder in einem Raum liegt noch unterwegs ist.
    var kannWareneingang = hatRaum
        && (gegenstand.Seriennummer == null || Model.Eintrag.Status == GegenstandUebersichtViewModel.KeinBestand);
    // Holen geht nur aus einem fremden Lager mit verantwortlicher Person, die freigibt (wie die Auswahl in "Aus dem Lager holen").
    // Der erste Treffer ist das Lager mit dem meisten Bestand.
    var holenAus = !hatRaum
        ? null
        : Model.Eintrag.Standorte.FirstOrDefault(r => !eigeneRaumIDs.Contains(r.RaumID) && r.Raum.Raumart.IstLager && r.Raum.PersonID != null);
    var kannHolen = holenAus != null;
    // Liegt das Gerät nur in normalen Räumen, kann man es nicht holen, dann steht da, wer es verlegen kann.
    string? holenHinweis = null;
    if (hatRaum && !kannAusleihen && !kannHolen && verleihenAusLager == null && Model.Eintrag.Standorte.Count > 0)
    {
        var wo = string.Join("; ", Model.Eintrag.Standorte.Take(3).Select(r =>
            $"{r.RaumID} · {r.Raum.Raumart.Name}" + (r.Raum.Person == null ? "" : $" (verantwortlich: {r.Raum.Person.VollerName})")));
        holenHinweis = $"Holen geht nur aus einem Lager. Dieses Gerät liegt in {wo}. Nur die verantwortliche Person kann es verlegen.";
    }

    // Die Kennung im Pfad ist die Seriennummer, ohne Seriennummer die ID.
    var kennung = gegenstand.Seriennummer ?? $"ID {gegenstand.ID}";

    // Der Standort ist der Raum mit der größten Menge, bei mehreren Räumen kommt die Zahl der übrigen dazu.
    var standort = Model.Eintrag.Standort;
    string standortZeile;
    if (standort == null)
    {
        standortZeile = "kein Standort";
    }
    else
    {
        standortZeile = $"Standort {standort}";
    }
    var verantwortlich = Model.Eintrag.ErsterRaum?.Person?.VollerName ?? "–";

    var bestandText = $"{Model.Eintrag.Stueck} Stück";
    var unterwegsStueck = Model.Unterwegs.Sum(l => l.Menge);
    if (unterwegsStueck > 0)
    {
        bestandText += $" · {unterwegsStueck} unterwegs";
    }

    var angaben = new (string Label, string Wert)[]
    {
        ("Seriennummer", gegenstand.Seriennummer ?? "–"),
        ("Kategorie", gegenstand.Kategorie.Name),
        ("Hersteller", gegenstand.Hersteller.Name),
        ("Standort", standort ?? "–"),
        ("Raumverantwortlich", verantwortlich),
        ("Bestand", bestandText)
    };

    // Der Hinweis wie im Design gilt für die älteste Bewegung, die noch auf die Freigabe wartet.
    // Freigeben muss beim Holen aus einem Lager die Person des Lagers, sonst die des Zielraums.
    var unterwegs = Model.Unterwegs.FirstOrDefault();
    var wartetAuf = unterwegs?.FreigabeRaum.Person?.VollerName ?? "–";
    string unterwegsText;
    if (unterwegs != null && gegenstand.Seriennummer == null)
    {
        unterwegsText = $"{unterwegs.Menge} Stück unterwegs";
    }
    else
    {
        unterwegsText = "Unterwegs";
    }

    // Das Datum im Verlauf hat im laufenden Jahr keine Jahreszahl.
    string Datum(DateTime zeitpunkt)
    {
        if (zeitpunkt.Year == DateTime.Now.Year)
        {
            return zeitpunkt.ToString("dd.MM.");
        }
        return zeitpunkt.ToString("dd.MM.yy");
    }
}

@* Desktop *@
<div class="seite geraet-detail d-none d-lg-flex">
    <nav class="brotkrumen" aria-label="Pfad">
        <a asp-action="Index">Katalog</a>
        <i data-lucide="chevron-right"></i>
        <a asp-action="Index" asp-route-kategorieID="@gegenstand.KategorieID">@gegenstand.Kategorie.Name</a>
        <i data-lucide="chevron-right"></i>
        <span>@kennung</span>
    </nav>

    <div class="detail-inhalt">
        <div class="detail-titel">
            <span class="tag @StatusTag.Klasse(Model.Eintrag.Status)">@Model.Eintrag.Status</span>
            <h1>@gegenstand.Name</h1>
            <span class="detail-unterzeile">@gegenstand.Kategorie.Name · @standortZeile</span>
        </div>

        @if (unterwegs != null)
        {
            <div class="blueprint hinweis-box">
                <i data-lucide="truck"></i>
                <div class="hinweis-box-text">
                    <b>@unterwegsText von @unterwegs.VonRaumID nach @unterwegs.NachRaumID</b> seit @unterwegs.ErstelltAm.ToString("dd.MM."), gebucht von @unterwegs.Person.Vorname @unterwegs.Person.Nachname.
                    Wartet auf die Freigabe durch @wartetAuf.
                    @if (Model.Unterwegs.Count > 1)
                    {
                        <text>Dazu @(Model.Unterwegs.Count - 1) weitere Ausleihen.</text>
                    }
                </div>
                @* Freigeben darf, wer für den freigebenden Raum verantwortlich ist, bei einem Lager auch ein Admin. *@
                @if (unterwegs.DarfFreigeben(personID, istAdmin))
                {
                    <a class="btn btn-primary" asp-controller="Uebernahme" asp-action="Index">Freigeben</a>
                }
            </div>
        }

        <div class="angaben-raster">
            @foreach (var angabe in angaben)
            {
                <div class="angabe">
                    <span class="angabe-label">@angabe.Label</span>
                    <span>@angabe.Wert</span>
                </div>
            }
        </div>

        @if (kannAusleihen || kannHolen || kannWareneingang || istAdmin)
        {
            <div class="detail-aktionen">
                @* Das Gerät ist vorausgewählt: Verleihen aus dem eigenen Raum, Holen aus dem Lager mit dem meisten Bestand. *@
                @if (kannAusleihen)
                {
                    <a class="btn btn-outline-secondary" asp-controller="Ausleihe" asp-action="Index" asp-route-vonRaumID="@ausEigenemRaum!.RaumID" asp-route-gegenstandID="@gegenstand.ID"><i data-lucide="arrow-right-left"></i>@(eigeneRaumIDs.Count > 1 ? $"Aus {ausEigenemRaum!.RaumID} verleihen" : "An anderen Raum verleihen")</a>
                }
                @if (verleihenAusLager != null)
                {
                    <a class="btn btn-outline-secondary" asp-controller="Ausleihe" asp-action="Index" asp-route-vonRaumID="@verleihenAusLager!.RaumID" asp-route-gegenstandID="@gegenstand.ID"><i data-lucide="arrow-right-left"></i>Aus Lager @verleihenAusLager.RaumID verleihen</a>
                }
                @if (kannHolen)
                {
                    <a class="btn btn-outline-secondary" asp-controller="Lager" asp-action="Index" asp-route-id="@holenAus!.RaumID" asp-route-gegenstandID="@gegenstand.ID"><i data-lucide="warehouse"></i>Aus Lager @holenAus.RaumID holen</a>
                }
                @if (kannWareneingang)
                {
                    <a class="btn btn-outline-secondary" asp-controller="MeinRaum" asp-action="Wareneingang" asp-route-gegenstandID="@gegenstand.ID"><i data-lucide="package-plus"></i>@(eigeneRaumIDs.Count == 1 ? $"Wareneingang in {eigeneRaumIDs[0]}" : "Wareneingang")</a>
                }
                @* Den Katalog sehen alle, bearbeiten und löschen darf nur ein Admin. *@
                @if (istAdmin)
                {
                    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@gegenstand.ID"><i data-lucide="pencil"></i>Bearbeiten</a>
                    <a class="btn btn-outline-secondary" asp-action="Delete" asp-route-id="@gegenstand.ID"><i data-lucide="trash-2"></i>Löschen</a>
                }
            </div>
        }

        @if (holenHinweis != null)
        {
            <p class="hinweis-klein"><i data-lucide="info"></i><span>@holenHinweis</span></p>
        }

        @* Nicht im Design: Gegenstände ohne Seriennummer können in mehreren Räumen liegen. *@
        @if (Model.Eintrag.Standorte.Count > 1)
        {
            <div class="bestand-liste">
                <h4>Bestand in Räumen</h4>
                @foreach (var bestand in Model.Eintrag.Standorte)
                {
                    <div class="bestand-zeile">
                        <span>@bestand.RaumID · @bestand.Raum.Raumart.Name</span>
                        <span>@bestand.Menge</span>
                    </div>
                }
            </div>
        }

        <div class="verlauf">
            <h4>Verlauf</h4>
            @for (var i = 0; i < Model.Verlauf.Count; i++)
            {
                <div class="verlauf-zeile">
                    <span class="verlauf-datum">@Datum(Model.Verlauf[i].Zeitpunkt)</span>
                    <span class="verlauf-punkt @(i == 0 ? "aktuell" : null)" aria-hidden="true"></span>
                    <span>@Model.Verlauf[i].Text</span>
                </div>
            }
            @if (Model.Verlauf.Count == 0)
            {
                <p class="aktivitaet-leer">Noch keine Buchungen.</p>
            }
        </div>
    </div>
</div>

@* Mobil: Die Angaben stehen als Liste, die Buttons unten. *@
<div class="detail-mobil d-lg-none">
    <a class="zurueck-link" asp-action="Index"><i data-lucide="chevron-left"></i>Katalog</a>

    <div class="detail-mobil-inhalt">
        <span class="tag @StatusTag.Klasse(Model.Eintrag.Status)">@Model.Eintrag.Status</span>
        <div>
            <h2>@gegenstand.Name</h2>
            <div class="seiten-untertitel">@(gegenstand.Seriennummer ?? gegenstand.Kategorie.Name) · @standort</div>
        </div>
        @if (unterwegs != null)
        {
            <div class="hinweis-flaeche"><b>@unterwegsText nach @unterwegs.NachRaumID</b>, wartet auf die Freigabe durch @wartetAuf.</div>
        }
        @foreach (var angabe in angaben)
        {
            <div class="angabe-zeile">
                <span class="angabe-label">@angabe.Label</span>
                <span>@angabe.Wert</span>
            </div>
        }
        @if (holenHinweis != null)
        {
            <div class="hinweis-flaeche">@holenHinweis</div>
        }
    </div>

    @if (kannAusleihen || kannHolen || kannWareneingang || istAdmin)
    {
        <div class="aktionsleiste">
            @if (kannAusleihen)
            {
                <a class="btn btn-outline-secondary" asp-controller="Ausleihe" asp-action="Index" asp-route-vonRaumID="@ausEigenemRaum!.RaumID" asp-route-gegenstandID="@gegenstand.ID">Verleihen</a>
            }
            @if (verleihenAusLager != null)
            {
                <a class="btn btn-outline-secondary" asp-controller="Ausleihe" asp-action="Index" asp-route-vonRaumID="@verleihenAusLager.RaumID" asp-route-gegenstandID="@gegenstand.ID">Verleihen</a>
            }
            @if (kannHolen)
            {
                <a class="btn btn-outline-secondary" asp-controller="Lager" asp-action="Index" asp-route-id="@holenAus!.RaumID" asp-route-gegenstandID="@gegenstand.ID">Holen</a>
            }
            @if (kannWareneingang)
            {
                <a class="btn btn-outline-secondary" asp-controller="MeinRaum" asp-action="Wareneingang" asp-route-gegenstandID="@gegenstand.ID">Einbuchen</a>
            }
            @if (istAdmin)
            {
                <a class="btn btn-outline-secondary btn-icon" asp-action="Delete" asp-route-id="@gegenstand.ID" title="Löschen" aria-label="Löschen"><i data-lucide="trash-2"></i></a>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@gegenstand.ID">Bearbeiten</a>
            }
        </div>
    }
</div>
