@model Lagerverwaltungsapp_MatthiasUtrata.Models.UebernahmeViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Freigaben";

    var kultur = new CultureInfo("de-AT");

    // Das Datum steht wie im Design, z. B. "Mo, 28.09.".
    string Datum(DateTime zeitpunkt) => zeitpunkt.ToString("dddd", kultur)[..2] + zeitpunkt.ToString(", dd.MM.");

    // Auf den Karten steht "vor 20 Min.", "vor 1 Std.", "gestern", sonst das Datum.
    string Wann(DateTime zeitpunkt)
    {
        var vergangen = DateTime.Now - zeitpunkt;
        if (vergangen.TotalMinutes < 1)
        {
            return "gerade eben";
        }
        if (vergangen.TotalMinutes < 60)
        {
            return $"vor {(int)vergangen.TotalMinutes} Min.";
        }
        if (zeitpunkt.Date == DateTime.Today)
        {
            return $"vor {(int)vergangen.TotalHours} Std.";
        }
        if (zeitpunkt.Date == DateTime.Today.AddDays(-1))
        {
            return "gestern";
        }
        return Datum(zeitpunkt);
    }

    // Bei Erledigtem steht "heute 07:48", "gestern 16:10", sonst das Datum.
    string Erledigt(DateTime zeitpunkt)
    {
        if (zeitpunkt.Date == DateTime.Today)
        {
            return $"heute {zeitpunkt:HH:mm}";
        }
        if (zeitpunkt.Date == DateTime.Today.AddDays(-1))
        {
            return $"gestern {zeitpunkt:HH:mm}";
        }
        return Datum(zeitpunkt);
    }

    // Die Menge steht hinter dem Namen, z. B. "Tablet × 5", bei einem Stück nichts.
    string Menge(Lagerbewegung bewegung)
    {
        if (bewegung.Menge > 1)
        {
            return $" × {bewegung.Menge}";
        }
        return "";
    }

    // Unter dem Namen steht die Menge bzw. die Seriennummer.
    string Angabe(Lagerbewegung bewegung)
    {
        if (bewegung.Gegenstand.Seriennummer == null)
        {
            return $"{bewegung.Menge} Stück, ohne Seriennummer";
        }
        return $"Seriennummer {bewegung.Gegenstand.Seriennummer}";
    }

    // Der Untertitel nennt die eigenen Räume und für einen Admin die Lager, für die er zusätzlich freigibt.
    var lager = string.Join(", ", Model.Lager.Select(r => r.ID));
    var raeumeKurz = string.Join(", ", Model.Raeume.Select(r => r.ID));
    string raeume;
    if (Model.Raeume.Count == 1)
    {
        raeume = $"Ihren Raum {Model.Raeume[0].ID} · {Model.Raeume[0].Raumart.Name}";
    }
    else
    {
        raeume = $"Ihre Räume {raeumeKurz}";
    }
    string fuer;
    string fuerKurz;
    if (Model.Raeume.Count > 0 && Model.Lager.Count > 0)
    {
        fuer = $"Anfragen für {raeume} und als Admin für die Lager {lager}";
        fuerKurz = $"{raeumeKurz}, {lager}";
    }
    else if (Model.Raeume.Count > 0)
    {
        fuer = $"Anfragen für {raeume}";
        fuerKurz = raeumeKurz;
    }
    else
    {
        fuer = $"Anfragen für die Lager {lager} (als Admin)";
        fuerKurz = lager;
    }
}

<div class="seite freigaben">
    <div class="seiten-kopf">
        <div>
            <h1>Freigaben</h1>
            @if (Model.GibtFrei)
            {
                <div class="seiten-untertitel d-none d-lg-block">@fuer</div>
                <div class="seiten-untertitel d-lg-none">@fuerKurz · @Model.Offen.Count offen</div>
            }
        </div>
        @* Nicht im Design: Mehrere Anfragen können auf einmal freigegeben werden. *@
        @if (Model.Offen.Count > 1)
        {
            <form class="d-none d-lg-block" asp-action="Bestaetigen" method="post">
                @foreach (var bewegung in Model.Offen)
                {
                    <input type="hidden" name="ids" value="@bewegung.ID" />
                }
                <button type="submit" class="btn btn-outline-secondary"><i data-lucide="check-check"></i>Alle freigeben (@Model.Offen.Count)</button>
            </form>
        }
    </div>

    <partial name="_Meldungen" />

    @if (!Model.GibtFrei)
    {
        <p class="text-muted">Sie sind derzeit für keinen Raum verantwortlich, daher gibt es nichts freizugeben.</p>
    }
    else if (!Model.Offen.Any())
    {
        <p class="text-muted">Es warten keine Anfragen auf Ihre Freigabe.</p>
    }
    else
    {
        @* Jede Anfrage ist eine Lagerbewegung: eine Ausleihe oder Rückgabe in den eigenen Raum oder Geräte, die jemand aus dem eigenen Lager holt.
           "Freigeben" bestätigt sie und bucht die Geräte im Nach-Raum ein. *@
        <div class="freigaben-raster">
            @foreach (var bewegung in Model.Offen)
            {
                <div class="blueprint freigabe-karte">
                    <div class="freigabe-kopf">
                        <span class="tag tag-outline">@(bewegung.IstRueckgabe ? "Rückgabe" : "Ausleihe")</span>
                        <span class="freigabe-zeit"><span class="d-lg-none">@bewegung.Person.Vorname @bewegung.Person.Nachname · </span>@Wann(bewegung.ErstelltAm)</span>
                    </div>
                    <h2 class="uebernahme-titel">@bewegung.Gegenstand.Name@Menge(bewegung)</h2>
                    <div class="route">
                        <i data-lucide="map-pin"></i>
                        <span>@bewegung.VonRaumID · @bewegung.VonRaum.Raumart.Name → @bewegung.NachRaumID · @bewegung.NachRaum.Raumart.Name</span>
                    </div>
                    <div class="freigabe-info d-none d-lg-block">
                        @bewegung.Bewegungsart.Name · @Angabe(bewegung)
                    </div>
                    <div class="karte-fuss d-none d-lg-flex">
                        <span class="avatar avatar-sm" aria-hidden="true">@bewegung.Person.Initialen</span>
                        <span class="freigabe-person">@bewegung.Person.Vorname @bewegung.Person.Nachname</span>
                    </div>
                    <form asp-action="Bestaetigen" method="post">
                        <input type="hidden" name="ids" value="@bewegung.ID" />
                        <button type="submit" class="btn btn-primary btn-cta w-100"><i data-lucide="check"></i>Freigeben</button>
                    </form>
                    @* Nicht im Design: Wer eine Anfrage nicht freigeben will, lehnt sie ab, und die Menge geht zurück in den Von-Raum. *@
                    <form asp-action="Ablehnen" asp-route-id="@bewegung.ID" method="post"
                          data-bestaetigen="Anfrage ablehnen? @bewegung.Gegenstand.Name@Menge(bewegung) geht zurück in Raum @bewegung.VonRaumID.">
                        <button type="submit" class="btn btn-outline-secondary w-100"><i data-lucide="x"></i>Ablehnen</button>
                    </form>
                </div>
            }
        </div>
    }

    @* Nicht im Design: Was ein Admin aus einem Lager verliehen hat, wartet auf die Person des Zielraums.
       Bis dahin kann er es hier zurückziehen (aus dem eigenen Raum geht das unter "Mein Raum"). *@
    @if (Model.Angefragt.Any())
    {
        <section>
            <h4>Von Ihnen aus einem Lager angefragt, noch nicht freigegeben</h4>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Gegenstand</th>
                            <th class="text-end">Menge</th>
                            <th>Von → Nach</th>
                            <th>Angefragt am</th>
                            <th>Status</th>
                            <th class="text-end">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bewegung in Model.Angefragt)
                        {
                            <tr>
                                <td>
                                    <div class="fw-medium">@bewegung.Gegenstand.Name</div>
                                    <div class="small text-muted">@(bewegung.Gegenstand.Seriennummer ?? "ohne Seriennummer") · @bewegung.Bewegungsart.Name</div>
                                </td>
                                <td class="text-end">@bewegung.Menge</td>
                                <td class="text-nowrap">@bewegung.VonRaumID → @bewegung.NachRaumID</td>
                                <td class="text-nowrap">@bewegung.ErstelltAm.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="tag tag-outline">Freigabe offen</span>
                                    <div class="small text-muted">wartet auf @(bewegung.FreigabeRaum.Person?.VollerName ?? "–")</div>
                                </td>
                                <td class="text-end">
                                    <form asp-action="Zurueckziehen" asp-route-id="@bewegung.ID" method="post"
                                          data-bestaetigen="Anfrage zurückziehen? @bewegung.Gegenstand.Name@Menge(bewegung) geht zurück in Raum @bewegung.VonRaumID.">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Zurückziehen</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @* Im Mobil-Design gibt es die erledigten Anfragen nicht. *@
    @if (Model.Erledigt.Any())
    {
        <section class="erledigt d-none d-lg-block">
            <h4>Erledigt</h4>
            <ul class="erledigt-liste">
                @foreach (var bewegung in Model.Erledigt)
                {
                    // Das gilt für Übernommenes oder Storniertes (abgelehnt oder vom Von-Raum zurückgezogen).
                    // Bei einer stornierten Rückgabe ist die Bewegungsart "Storniert", dann steht dort "Ausleihe".
                    var text = $"{bewegung.Gegenstand.Name}{Menge(bewegung)} · {(bewegung.IstRueckgabe ? "Rückgabe" : "Ausleihe")} {bewegung.VonRaumID} → {bewegung.NachRaumID}";
                    var icon = "check";
                    if (bewegung.Storniert)
                    {
                        text += " · storniert";
                        icon = "x";
                    }
                    <li>
                        <i data-lucide="@icon"></i>
                        <span class="flex-grow-1">@text</span>
                        <span class="erledigt-zeit">@Erledigt(bewegung.BestaetigtAm!.Value)</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>
