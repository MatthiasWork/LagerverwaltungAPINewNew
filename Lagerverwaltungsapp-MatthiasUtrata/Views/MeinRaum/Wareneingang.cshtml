@model Lagerverwaltungsapp_MatthiasUtrata.Models.WareneingangViewModel

@{
    ViewData["Title"] = "Wareneingang";

    // Das sind die Kategorien, von denen etwas einzubuchen ist, für den Filter über der Liste.
    var kategorien = Model.Gegenstaende.Select(g => g.Kategorie).DistinctBy(k => k.ID).OrderBy(k => k.Name).ToList();
}

<div>
    @if (Model.Raeume.Count == 1)
    {
        <div class="mb-1 text-muted">Raum @Model.Raum.ID · @Model.Raum.Raumart.Name</div>
    }
    <h1 class="mb-0">Wareneingang</h1>
</div>
<hr />
<div class="row">
    <div class="col-md-8 col-xl-6">
        <p class="text-muted">
            @if (Model.Raeume.Count == 1)
            {
                <text>Neue Gegenstände kommen hier in den Bestand von Raum @Model.Raum.ID.</text>
            }
            else
            {
                <text>Neue Gegenstände kommen hier in den Bestand des gewählten Raums.</text>
            }
            Die Buchung ist sofort bestätigt und steht danach im Verlauf des Gegenstands. Neue Gegenstände legt ein Admin vorher im Katalog an.
        </p>

        @if (!Model.Gegenstaende.Any())
        {
            <p class="text-muted">Es gibt keinen Gegenstand, der eingebucht werden kann.</p>
            <a asp-action="Index" asp-route-id="@Model.Raum.ID" class="btn btn-outline-secondary">Zurück zu Mein Raum</a>
        }
        else
        {
            <form asp-action="Wareneingang" method="post" id="wareneingangFormular">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @* Nicht im Design: Wer für mehrere Räume verantwortlich ist, wählt den Raum, in den eingebucht wird. *@
                @if (Model.Raeume.Count > 1)
                {
                    <div class="form-group">
                        <label asp-for="RaumID" class="control-label"></label>
                        <select asp-for="RaumID" class="form-select" required>
                            @foreach (var raum in Model.Raeume)
                            {
                                <option value="@raum.ID">@raum.ID · @raum.Raumart.Name</option>
                            }
                        </select>
                        <span asp-validation-for="RaumID" class="text-danger"></span>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="RaumID" />
                }

                <div class="form-group">
                    <label for="geraetSuche" class="control-label">@Html.DisplayNameFor(m => m.GegenstandID)</label>
                    @* Der gewählte Gegenstand steht im versteckten Feld, gewählt wird in der Liste darunter. *@
                    <input type="hidden" asp-for="GegenstandID" id="gegenstandFeld" />

                    @* Beim Suchen oder Scannen einer Seriennummer zeigt die Liste nur die Treffer, Enter wählt den ersten. *@
                    <div class="geraet-hinzufuegen">
                        <i data-lucide="scan-line"></i>
                        <input type="search" id="geraetSuche" placeholder="Gerät scannen oder Name/Seriennummer eingeben" autocomplete="off"
                               aria-label="Gegenstand suchen" aria-controls="geraetListe" />
                    </div>

                    <div class="bestand-auswahl mt-2">
                        <div class="auswahl-kopf">
                            <select class="filter-auswahl" id="geraetKategorie" aria-label="Kategorie">
                                <option value="">Kategorie: alle</option>
                                @foreach (var kategorie in kategorien)
                                {
                                    <option value="@kategorie.ID">Kategorie: @kategorie.Name</option>
                                }
                            </select>
                            <span class="nebeninfo" id="geraetAnzahl" aria-live="polite"></span>
                        </div>
                        <div class="auswahl-liste" id="geraetListe">
                            @foreach (var gegenstand in Model.Gegenstaende)
                            {
                                <div class="auswahl-zeile" data-id="@gegenstand.ID" data-seriennummer="@gegenstand.Seriennummer"
                                     data-suchtext="@($"{gegenstand.Name} {gegenstand.Seriennummer} {gegenstand.Kategorie.Name}".ToLowerInvariant())"
                                     data-kategorie-id="@gegenstand.KategorieID">
                                    <div>
                                        <div class="fw-medium">@gegenstand.Name</div>
                                        <div class="geraet-zeile-info">@gegenstand.Kategorie.Name · @(gegenstand.Seriennummer ?? "ohne Seriennummer")</div>
                                    </div>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="@gegenstand.Name auswählen">Auswählen</button>
                                </div>
                            }
                            <div class="vorschlag-leer" id="geraetKeine" hidden>Kein passendes Gerät</div>
                        </div>
                    </div>

                    <span asp-validation-for="GegenstandID" class="text-danger"></span>
                    <div class="text-danger" id="gegenstandFehler" hidden>Bitte einen Gegenstand auswählen.</div>
                    <div class="form-text">Geräte mit Seriennummer, die schon in einem Raum liegen oder unterwegs sind, fehlen in der Liste.</div>
                </div>

                <div class="form-group">
                    <label asp-for="Menge" class="control-label"></label>
                    <input asp-for="Menge" type="number" min="1" max="@Gegenstand.HoechstBestand" step="1" class="form-control" id="mengeFeld" />
                    <span asp-validation-for="Menge" class="text-danger"></span>
                    <div class="form-text">Ein Gerät mit Seriennummer wird immer mit der Menge 1 eingebucht.</div>
                </div>

                <div class="form-group">
                    <label asp-for="BewegungsartID" class="control-label"></label>
                    <select asp-for="BewegungsartID" class="form-select" asp-items="Model.Bewegungsarten">
                        <option value="">Bewegungsart auswählen</option>
                    </select>
                    <span asp-validation-for="BewegungsartID" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Einbuchen" class="btn btn-primary" />
                    <a asp-action="Index" asp-route-id="@Model.Raum.ID" class="btn btn-outline-secondary">Abbrechen</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Der Gegenstand wird in der Liste gewählt, Suche und Kategorie grenzen sie ein, Enter wählt den ersten Treffer.
        // Bei einem Gerät mit Seriennummer ist die Menge immer 1 und kann nicht geändert werden.
        (function () {
            var formular = document.getElementById('wareneingangFormular');
            if (!formular) {
                return;
            }
            var gegenstandFeld = document.getElementById('gegenstandFeld');
            var menge = document.getElementById('mengeFeld');
            var suchfeld = document.getElementById('geraetSuche');
            var kategorie = document.getElementById('geraetKategorie');
            var liste = document.getElementById('geraetListe');
            var keine = document.getElementById('geraetKeine');
            var fehler = document.getElementById('gegenstandFehler');
            var zeilen = Array.prototype.slice.call(liste.querySelectorAll('.auswahl-zeile'));

            function mengeAnpassen(zeile) {
                var einzelgeraet = zeile && zeile.dataset.seriennummer;
                if (einzelgeraet) {
                    menge.value = 1;
                }
                menge.readOnly = !!einzelgeraet;
            }

            function auswaehlen(zeile) {
                gegenstandFeld.value = zeile.dataset.id;
                zeilen.forEach(function (andere) {
                    var gewaehlt = andere === zeile;
                    andere.classList.toggle('gewaehlt', gewaehlt);
                    var knopf = andere.querySelector('button');
                    knopf.disabled = gewaehlt;
                    knopf.textContent = gewaehlt ? 'Ausgewählt' : 'Auswählen';
                });
                fehler.hidden = true;
                mengeAnpassen(zeile);
            }

            // Die Liste zeigt nur Geräte, die zu Suchbegriff und Kategorie passen.
            function filtern() {
                var begriff = suchfeld.value.trim().toLowerCase();
                var art = kategorie.value;
                var sichtbar = 0;
                zeilen.forEach(function (zeile) {
                    var passt = (begriff === '' || zeile.dataset.suchtext.indexOf(begriff) !== -1)
                        && (art === '' || zeile.dataset.kategorieId === art);
                    zeile.hidden = !passt;
                    if (passt) {
                        sichtbar++;
                    }
                });
                keine.hidden = sichtbar > 0;

                var text = sichtbar === 1 ? '1 Gerät' : sichtbar + ' Geräte';
                if (sichtbar !== zeilen.length) {
                    text = sichtbar + ' von ' + zeilen.length + (zeilen.length === 1 ? ' Gerät' : ' Geräten');
                }
                document.getElementById('geraetAnzahl').textContent = text;
            }

            zeilen.forEach(function (zeile) {
                zeile.querySelector('button').addEventListener('click', function () {
                    auswaehlen(zeile);
                });
            });

            suchfeld.addEventListener('input', filtern);
            kategorie.addEventListener('change', filtern);
            suchfeld.addEventListener('keydown', function (e) {
                // Enter wählt den ersten Treffer (z. B. nach dem Scannen), statt das Formular abzuschicken.
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var erster = zeilen.find(function (zeile) { return !zeile.hidden; });
                    if (erster) {
                        auswaehlen(erster);
                    }
                }
            });

            // Ohne Gegenstand wird nicht abgeschickt, denn das versteckte Feld prüft der Browser nicht selbst.
            formular.addEventListener('submit', function (e) {
                if (gegenstandFeld.value === '') {
                    e.preventDefault();
                    fehler.hidden = false;
                    suchfeld.focus();
                }
            });

            filtern();

            // Ein schon gewählter Gegenstand (z. B. aus dem Gerätedetail oder nach einem Fehler) wird markiert und in Sicht gerollt.
            var vorgewaehlt = zeilen.find(function (zeile) { return zeile.dataset.id === gegenstandFeld.value; });
            if (vorgewaehlt) {
                auswaehlen(vorgewaehlt);
                // Er wird mittig in der Liste gezeigt, soweit sie sich so weit rollen lässt.
                var abstand = (liste.clientHeight - vorgewaehlt.offsetHeight) / 2;
                liste.scrollTop += vorgewaehlt.getBoundingClientRect().top - liste.getBoundingClientRect().top - abstand;
            } else {
                mengeAnpassen(null);
            }
        })();
    </script>
}
